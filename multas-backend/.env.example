NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pmt_multas
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=20
PUBLIC_PAYMENT_RATE_LIMIT_MAX=60

SESSION_COOKIE_NAME=pmt_session
SESSION_SAME_SITE=lax
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
PRIVATE_UPLOAD_DIR=storage/private
MAX_EVIDENCE_BYTES=10000000
HISTORICAL_MIGRATION_DIR=storage/private/historical-migrations
HISTORICAL_MIGRATION_MAX_BYTES=20000000
HISTORICAL_MIGRATION_RETENTION_DAYS=90
PUBLIC_APP_URL=http://127.0.0.1:5173

# Pago en línea: disabled (producción sin proveedor), test (QA local) o external (gateway alojado).
PAYMENT_GATEWAY_MODE=disabled
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
