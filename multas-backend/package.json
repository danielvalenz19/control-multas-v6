{
  "name": "multas-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mysql": "RUN_MYSQL_INTEGRATION=true vitest run tests/integration/mysql.integration.test.ts",
    "test:integration": "RUN_MYSQL_INTEGRATION=true vitest run tests/integration/*.test.ts",
    "migration:status": "tsx scripts/migration-status.ts",
    "migration:status:auth": "tsx scripts/migration-status.ts --scope auth",
    "migration:status:full": "tsx scripts/migration-status.ts --scope full",
    "migrate": "tsx scripts/migrate.ts",
    "rbac:status": "tsx scripts/rbac-status.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "auth:verify": "tsx scripts/verify-auth-flow.ts",
    "sessions:cleanup": "tsx scripts/cleanup-sessions.ts",
    "migration:historical:dry-run": "tsx scripts/historical-migration.ts dry-run",
    "migration:historical:commit": "tsx scripts/historical-migration.ts commit",
    "migration:historical:revert": "tsx scripts/historical-migration.ts revert",
    "migration:historical:cleanup": "tsx scripts/historical-migration.ts cleanup"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "pino": "^10.1.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  }
}
